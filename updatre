.panel {
  backdrop-filter: blur(12px);
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  transition: transform 0.3s ease, opacity 0.3s ease;
}
.panel.show {
  transform: translateY(0);
  opacity: 1;
}
.panel.hide {
  transform: translateY(20px);
  opacity: 0;
}
                          
