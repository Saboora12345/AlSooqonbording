{
  "name": "@alsooq/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the alSooq / Hawil ecosystem — Marketplace, Mobility (Mowasalaty) and Logistics (Suda Express + escrow) tools.",
  "type": "module",
  "bin": {
    "alsooq-mcp": "dist/index.js"
  },
  "scripts": {
