generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Swap to "postgresql" / "mysql" later — application code is unaffected.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum FareTier {
  short
  medium
  long
}

enum BookingStatus {
  held
  confirmed
  cancelled
}

model Stop {
  id      String  @id @default(cuid())
  name    String
  nameAr  String
  lat     Float
  lng     Float
  order   Int
  routeId String
  route   Route   @relation(fields: [routeId], references: [id])
}

model Route {
  id      String   @id @default(cuid())
  name    String
  nameAr  String
  tier    FareTier
  fareSdg Int
  stops   Stop[]
  trips   Trip[]
}

model Vehicle {
  id      String @id @default(cuid())
  label   String
  seatCap Int    @default(14)
  trips   Trip[]
}

model Trip {
  id           String    @id @default(cuid())
  routeId      String
  route        Route     @relation(fields: [routeId], references: [id])
  vehicleId    String
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])
  departureAt  DateTime
  seatsHeld    Int       @default(0)
  seatsBooked  Int       @default(0)
  bookings     Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  tripId         String
  trip           Trip          @relation(fields: [tripId], references: [id])
  boardingStopId String
  seatNumbers    String // JSON-encoded number[] — SQLite has no native array type
  seatCount      Int
  totalFareSdg   Int
  status         BookingStatus @default(held)
  createdAt      DateTime      @default(now())
}

model Wallet {
  id         String @id @default(cuid())
  ownerLabel String @default("demo-rider")
  balanceSdg Int    @default(2500)
}
